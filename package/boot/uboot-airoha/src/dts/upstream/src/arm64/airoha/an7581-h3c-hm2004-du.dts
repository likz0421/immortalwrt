/dts-v1/;

/* BL2 and TF-A reserve the first 2 MiB of DRAM. */
/memreserve/ 0x80000000 0x200000;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "en7581.dtsi"

/*
 * H3C HM2004-DU (联通定制 FTTR 主网关，AN7581CT).
 *
 *  - Winbond W25N02KV 256 MiB SPI NAND; BL2 occupies the first 128 KiB,
 *    everything after it is one UBI blob.
 *  - Board data lives in the 1 MiB "factory" UBI volume (the H3C factory
 *    layout built by the h3c-factory tool from the stock reservearea).
 *  - Panel LEDs: power / pon / los(red) / internet / wlan / usb, all GPIO.
 *  - lan1 hangs off gdm4 through an EN8811H 2.5G PHY on the switch MDIO;
 *    lan2-4 are the internal GE PHYs.
 */

/ {
	model = "H3C HM2004-DU";
	compatible = "h3c,hm2004-du", "airoha,an7581", "airoha,en7581";

	aliases {
		serial0 = &uart1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	options {
		u-boot {
			compatible = "u-boot,config";
			/* Web recovery LED chase, in this order; red stays out. */
			httpd-chase-leds = <&led_power &led_pon &led_internet &led_wlan>;
		};
	};

	/* 512 MiB fallback; dram_init() probes and fixups the real size. */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
	};

	keys {
		compatible = "gpio-keys";

		key-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power: led-power {
			label = "green:power";
			gpios = <&en7581_pinctrl 17 GPIO_ACTIVE_LOW>;
		};

		led_pon: led-pon {
			label = "green:pon";
			gpios = <&en7581_pinctrl 18 GPIO_ACTIVE_LOW>;
		};

		led-los {
			label = "red:los";
			gpios = <&en7581_pinctrl 19 GPIO_ACTIVE_LOW>;
		};

		led_internet: led-internet {
			label = "green:internet";
			gpios = <&en7581_pinctrl 20 GPIO_ACTIVE_LOW>;
		};

		led_wlan: led-wlan {
			label = "green:wlan";
			gpios = <&en7581_pinctrl 15 GPIO_ACTIVE_LOW>;
		};

		led-usb {
			label = "green:usb";
			gpios = <&en7581_pinctrl 34 GPIO_ACTIVE_LOW>;
		};
	};
};

&en7581_pinctrl {
	gpio-ranges = <&en7581_pinctrl 0 13 50>;
};

&snfi {
	status = "okay";
};

&spi_nand {
	/* Explicit on purpose: probe order has been flaky without it here. */
	compatible = "winbond,w25n02kv", "spi-nand";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "bl2";
			reg = <0x0 0x20000>;
		};

		partition@20000 {
			label = "ubi";
			reg = <0x20000 0xffe0000>;
		};
	};
};

&i2c0 {
	status = "okay";
};

&eth {
	status = "okay";
};
