# H3C HM2004-DU. Same migration story as ZN504XG-D: the stock reservearea
# is rebuilt by the h3c-factory tool into a 1 MiB "factory" volume (the
# H3C factory layout), which the recovery page writes back as board data.
# base-mac sits at offset 0x10 as 6 raw bytes; missing/blank falls through
# to the preinit random-MAC path.
soc=an7581
profile=h3c_hm2004-du-ubi
dts=airoha/an7581-h3c-hm2004-du
fdt=airoha/an7581-h3c-hm2004-du.dtb
led=green:power
bundle=an7581_web_defconfig
policy=foreign
factory_vols=factory:0x100000
factory_mac=factory:0x10
