# H3C HM2004-DU: the factory volume carries the H3C 1 MiB layout
# (magic "H3C-1MiB" @0, base MAC @0x10, SN/PON calibration/Wi-Fi EEPROM
# inside). The base MAC at 0x10 is 6 raw bytes; the 0x14102c style SN
# offsets only exist in the 2.25 MiB stock reservearea, not in this
# 1 MiB layout.
ubi_create_board_data=ubi check factory || ubi create factory 0x100000 dynamic || run ubi_format
ethaddr_factory=ubi read 0x90000000 factory && env readmem -b facmac 0x9000010 0x6 ; if test "$facmac" = "ff:ff:ff:ff:ff:ff" ; then echo factory volume holds no factory MAC ; setenv facmac ; fi ; if test -n "$facmac" ; then setenv ethaddr "$facmac" ; fi ; setenv facmac ; setenv ethaddr_factory
